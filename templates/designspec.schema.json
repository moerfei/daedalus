{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "daedalus/designspec",
  "title": "DesignSpec — 输入侧中间表示（v0.1 文字PRD通道）",
  "description": "S0 的产物：把文字PRD结构化为页面清单/交互清单/数据实体/风格提示。S1 规划器据此产出 PrototypeIR。",
  "type": "object",
  "required": ["meta", "summary", "pages", "interactions", "dataEntities"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "sourceFile": { "type": "string" }
      }
    },
    "summary": { "type": "string", "minLength": 10 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "intent"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^p-[a-z0-9-]+$" },
          "title": { "type": "string" },
          "intent": { "type": "string" },
          "features": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "trigger", "description"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "trigger": { "type": "string" },
          "description": { "type": "string" },
          "guard": { "type": "string" }
        }
      }
    },
    "dataEntities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity", "fields"],
        "additionalProperties": false,
        "properties": {
          "entity": { "type": "string" },
          "fields": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
        }
      }
    },
    "styleHints": { "type": "object", "additionalProperties": true },
    "openQuestions": { "type": "array", "items": { "type": "string" } }
  }
}
